//  Generated by TWT U-MAC in the AP with data from TWT Scheduler. Used as TWT response frame

import inet.common.INETDefs;
import inet.common.packet.chunk.Chunk;
import inet.linklayer.ieee80211.mac.Ieee80211Frame;
import inet.linklayer.common.MacAddress;

namespace inet::ieee80211;


class twtFrame extends FieldsChunk
{
	// R-TWT negotiation fields
	MacAddress STAaddress; // STA Address needed for AP to reply 
    uint8_t flowId;     // Unique token for matching requests/responses
    uint8_t type;            // Frame type (0 Response, 1 Request, 2 Teardown)
	uint8_t restriction; //0 for all, other - restriction groups
	uint8_t interfaceId;
	
    // TWT timing parameters
    simtime_t wakeTime;    // Start time of the TWT session
    uint8_t wakeDuration;  // Duration of the TWT session multiplied by 256us
    uint16_t intervalMantissa; //Interval of TWT session, when 0 - not periodic
    uint8_t intervalExponent; 	

}

